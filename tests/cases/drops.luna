# Values freed in every way the compiler drops them. The leak test runs this
# program and checks that no heap object is left at the end.

greet name = "hi, " + name
# `b` is still owned when the function ends, so it is dropped there
keep_first a b = a
pick n = check n:
    1 -> "one";
    2 -> 2.5;
    else -> n
# narrowing a boxed value to a string frees the box
shout s :: string -> string = s + "!"
# only the first arm moves `s`; the else arm drops it before leaving
choose c s = check c:
    1 -> s;
    else -> "other"
# `acc + "x"` is a new string; the old `acc` is dropped when the call returns
build n acc = check n:
    0 -> acc;
    else -> build (n - 1) (acc + "x")

main =
    echo (greet "bob")
    echo (keep_first (greet "a") (greet "b"))
    echo (shout (pick 1))
    echo (choose 1 (greet "c"))
    echo (choose 2 (greet "d"))
    check (greet "z"):
        "hi, z" -> echo "matched";
        else -> echo "no match"
    v = pick 2
    echo (v + 1)
    greet "discarded"
    a = greet "e"
    b = a
    c = b
    echo c
    c
    echo (build 5 "")
    "the result of main is dropped too"
