# Constant globals are computed by the compiler. Each one is printed next to
# the same expression computed at run time: every pair of lines must match.

count n = check n:
    0 -> 0;
    else -> 1 + count (n - 1)
pick n = check n:
    1 -> "one";
    else -> 2.5

g0 = 9223372036854775807 + 1
g1 = 7 / 2
g2 = 1 / 3
g3 = 0.1 + 0.2
g4 = 2 * 3.5
g5 = -(2 - 5)
g6 = -(0.5 - 0.5)
g7 = "apple" < "banana"
g8 = "b" > "abc"
g9 = "ab" <= "abc"
g10 = 1 == 1.0
g11 = 3 != 4
g12 = "con" + "cat"
g13 = 1e308 * 10
g14 = 0 - 1e308 * 10
g15 = 1e308 * 10 - 1e308 * 10
g16 = (1e308 * 10 - 1e308 * 10) == (1e308 * 10 - 1e308 * 10)
g17 = count 50
g18 = pick 1
g19 = pick 2

# not constants: a side effect, and a computation too deep to evaluate
banner = echo "welcome"
deep = count 5000

main =
    banner
    banner
    echo deep
    echo g0
    echo (9223372036854775807 + 1)
    echo g1
    echo (7 / 2)
    echo g2
    echo (1 / 3)
    echo g3
    echo (0.1 + 0.2)
    echo g4
    echo (2 * 3.5)
    echo g5
    echo (-(2 - 5))
    echo g6
    echo (-(0.5 - 0.5))
    echo g7
    echo ("apple" < "banana")
    echo g8
    echo ("b" > "abc")
    echo g9
    echo ("ab" <= "abc")
    echo g10
    echo (1 == 1.0)
    echo g11
    echo (3 != 4)
    echo g12
    echo ("con" + "cat")
    echo g13
    echo (1e308 * 10)
    echo g14
    echo (0 - 1e308 * 10)
    echo g15
    echo (1e308 * 10 - 1e308 * 10)
    echo g16
    echo ((1e308 * 10 - 1e308 * 10) == (1e308 * 10 - 1e308 * 10))
    echo g17
    echo (count 50)
    echo g18
    echo (pick 1)
    echo g19
    echo (pick 2)
