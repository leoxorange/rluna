# A call whose value is the function's result, with nothing left to do but
# return it, is in tail position. A function calling itself there starts
# again instead of going one call deeper, so it runs like a loop and never
# runs out of stack, however many times it goes round.

count n acc = check n:
    0 -> acc;
    else -> count (n - 1) (acc + n)

# in the arms of a `check`, the blocks of an `if`, and after `ret`
countdown n = if n == 0:
    "liftoff"
else:
    ret countdown (n - 1)

# a borrowed parameter goes along as it is
walk @xs i total = check i == len xs:
    true -> total;
    false -> walk xs (i + 1) (total + i)

# a value moved into each round
build n s = check n == 0:
    true -> len s;
    false -> build (n - 1) (s + "x")

# one definition calling another: the call chooses one of them while the
# program runs, and only the call of the same definition starts it again
sum_list [] acc = acc
sum_list (x:xs) acc = sum_list xs (acc + x)

# `&&` and `||` are `check`s too: their right side is in tail position
thirds n = n == 0 || n > 0 && thirds (n - 3)

main =
    echo (count 1000000 0)
    echo (countdown 1000000)
    echo (walk [0..200000] 0 0)
    echo (build 1000 "")
    echo (sum_list [1..1001] 0)
    echo (thirds 999999)
    echo (thirds 1000000)
