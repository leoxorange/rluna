# Every example from readme.md, gathered into one program.

foo = (5 + 1)*6
pred a = a - 1
test _ = check _:
    1 -> echo "success";
    else -> test (pred _)

b = 10
sum a b = a + b
summon a = check a:
    1 -> summon (sum a 9);
    10 -> echo "summon successfully";
    else -> echo "summon failed"

typed_sum a b :: numeric, numeric -> numeric = a + b + 5
discard _ :: any -> void = 5
flag :: boolean = 5 > 6
head a :: numeric -> void = echo "winning"
head _ = echo "nothing left"

main =
    echo (5 > 6)
    echo (5 == 5)
    echo (4 < 10)
    echo flag
    echo (10 + 8 * 7)
    echo foo
    test 5
    summon 1
    summon 2
    echo (typed_sum 1 2)
    echo (typed_sum 1.5 2)
    echo (discard "x")
    echo (7 / 2)
    echo ("con" + "cat")
    test foo
    loop x in [0, 5]: # [0, 5] means 0, 1, 2, 3, 4
        echo x
    head 1
    head "x"
