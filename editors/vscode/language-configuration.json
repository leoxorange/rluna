{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(:|=)\\s*(#.*)?$",
    "decreaseIndentPattern": "^(?!)"
  },
  "onEnterRules": [
    {
      "beforeText": "^.*(:|=)\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "@?[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*|-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?"
}
