# The Luna standard library.
#
# It is compiled together with every program; only the functions a program
# uses end up in its executable. A program that defines a function with the
# same name uses its own definition instead (all of them).
#
# Functions that only read an array or a string borrow it (`@a`), so the
# caller keeps it: after `sum a`, `a` is still there. Functions that build
# their result out of the elements (`take`, `drop`, `flatten`, `remove`,
# `maximum`, `minimum`) take it, like `tail` and `++`, and nothing is
# copied.
#
# Functions that compare values (`max`, `min`, `maximum`, `minimum`,
# `contains`, `count`, `index_of`, `remove`) work for every trail that
# follows Compare, a program's trails too. The ones that add up numbers
# start from 0 or 1, so they work for the embedded numbers.

# -- the embedded trails ----------------------------------------------------
#
# Trails every program can follow and name in signatures. The compiler
# knows what they mean (`echo` prints a `textualize`, `<` calls `compare`,
# `+` calls `add`), but what they ask for is written here.

# Every value follows Any.
trail Any:
    # What `echo` prints for the value: its `textualize` if its trail
    # follows Show, else the name of its trail.
    native text :: String

# Printable: `echo` prints a value's `textualize`.
trail Show:
    textualize :: String

# A pass for `copy`: only a value whose trail follows Copy can be copied.
trail Copy:
    # A copy of the whole value, owned by whoever receives it.
    native copy :: Self

# Comparable: `<`, `<=`, `>`, `>=`, `==`, `!=` and `check` patterns come from
# `a.compare b`, which is -1 if `a` comes first, 0 if they are equal, and 1
# if `b` does. (Operators only read their operands: `other` is borrowed.)
trail Compare:
    compare @other :: Self -> Int

# Plays like a number: `a + b` is `a.add b`, `a - b` is `a.sub b`, and so
# on, for two values of the same trail.
trail Numeric follow Show, Compare:
    add @other :: Self -> Self
    sub @other :: Self -> Self
    mul @other :: Self -> Self
    div @other :: Self -> Self

# What a loop or a list comprehension can go through.
trail Iterable:

# The embedded values are machine values, which the compiler gives their
# functions (`1 + 0.5` is 1.5, since ints and floats are both numbers). These
# lines say which trails they follow. An array follows Show and Copy only
# when its elements do.
trail Int follow Numeric, Copy:
trail Float follow Numeric, Copy:
#
# `native` functions of these trails are given by the compiler: the few
# things only the machine can do with the values. `Self` is the type of the
# value, `Element` that of its elements (a string's are strings).
trail String follow Show, Compare, Copy, Iterable:
    # How many characters it has.
    native len :: Int
    # The characters from position `from` up to (not including) `to`.
    native slice from to :: Int, Int -> Self
    # The character at position `i`; out of range stops the program with
    # an IndexError.
    native at i :: Int -> Element
trail Boolean follow Show, Copy:
trail Void follow Show, Copy:
trail Array follow Show, Copy, Iterable:
    # How many elements it has.
    native len :: Int
    # Copies of the elements from position `from` up to (not including)
    # `to`.
    native slice from to :: Int, Int -> Self
    # A copy of the element at position `i`; out of range stops the
    # program with an IndexError.
    native at i :: Int -> Element

# -- values ------------------------------------------------------------------

# Void has no length: `len` of a value that may be void (`len (tail a)`) is
# void when it is.
len @v :: Void -> Void = void

# Prints a value, and a newline after it: its `textualize`, or the name of
# a trail that does not follow Show. (A string is printed as it is, without
# making its text first.)
echo @s :: String -> Void =
    print s
    print "\n"
echo @x :: Any -> Void =
    print (text x)
    print "\n"

# The first element (a copy), or void if there is none.
head @a :: Iterable? = copy (a !! 0)

# The last element (a copy), or void if there is none.
last @a :: Iterable? = check a:
    void -> void;
    else -> copy (a !! (len a - 1))

# Everything after the first element (copies), or void if there is none.
tail @a :: Iterable? = check a:
    void -> void;
    else -> check len a:
        0 -> void;
        else -> slice a 1 (len a)

# Everything before the last element (copies), or void if there is none.
init @a :: Iterable? = check a:
    void -> void;
    else -> check len a:
        0 -> void;
        else -> slice a 0 (len a - 1)

# The elements (copies) in the opposite order.
reverse @a :: Array -> Array =
    n = len a
    [at a (n - 1 - i) | i in [0..n]]

# The characters in the opposite order.
reverse @s :: String -> String =
    chars = [c | c in @s]
    n = len chars
    concat [at chars (n - 1 - i) | i in [0..n]]

# -- numbers -----------------------------------------------------------------

# The distance from zero: `abs (-3)` is 3.
abs x :: Numeric -> Numeric = check x < 0:
    true -> -x;
    false -> x

# The larger of two values that can be compared.
max a b :: Compare, Compare -> Compare = check a < b:
    true -> b;
    false -> a

# The smaller of two values that can be compared.
min a b :: Compare, Compare -> Compare = check b < a:
    true -> b;
    false -> a

# The sum of an array of numbers; 0 for an empty array.
sum @a :: Array -> Numeric =
    total = 0
    loop x in @a:
        total = total + x
    total

# The product of an array of numbers; 1 for an empty array.
product @a :: Array -> Numeric =
    total = 1
    loop x in @a:
        total = total * x
    total

# The average of an array of numbers (a float), or void for an empty array.
average @a :: Array =
    n = len a
    check n:
        0 -> void;
        else -> sum a / n

# -- searching ---------------------------------------------------------------

# The largest element, or void for an empty array. (It gives an element of
# `a`, so it takes `a`.)
maximum (x:xs) :: Array -> Any =
    best = x
    loop y in xs:
        best = check y > best:
            true -> y;
            false -> best
    best
maximum [] = void

# The smallest element, or void for an empty array.
minimum (x:xs) :: Array -> Any =
    best = x
    loop y in xs:
        best = check y < best:
            true -> y;
            false -> best
    best
minimum [] = void

# Whether `a` (an array or a string) has an element equal to `x`.
contains @a @x :: Iterable, Any -> Boolean =
    loop y in @a:
        check y == x:
            true -> ret true;
            false -> void
    false

# How many elements of `a` are equal to `x`.
count @a @x :: Iterable, Any -> Int =
    n = 0
    loop y in @a:
        n = check y == x:
            true -> n + 1;
            false -> n
    n

# The position of the first element of `a` equal to `x`, or void.
index_of @a @x :: Iterable, Any =
    loop i, y in @a:
        check y == x:
            true -> ret i;
            false -> void
    void

# The elements of `a` that are not equal to `x`.
remove a @x :: Iterable, Any -> Array = [y | y in a, y != x]

# -- building arrays ---------------------------------------------------------

# The first `n` elements (all of them if there are fewer).
take n a :: Int, Array -> Array = [x | i, x in a, i < n]

# The elements after the first `n`.
drop n a :: Int, Array -> Array = [x | i, x in a, i >= n]

# The arrays in `a` joined into one: `flatten [[1], [2, 3]]` is [1, 2, 3].
flatten a :: Array -> Array = [x | part in a, x in part]

# Whether an array or a string has no elements.
is_empty @a :: Iterable -> Boolean = len a == 0

# -- strings -----------------------------------------------------------------

# The strings in `a` joined, with `sep` between them:
# `join ["a", "b"] ", "` is "a, b".
join @a @sep :: Array, String -> String =
    out = ""
    first = true
    loop s in @a:
        out = check first:
            true -> out;
            false -> out + sep
        out = out + s
        first = false
    out

# The parts of `s` between the occurrences of the character `sep`:
# `split "a,b" ","` is ["a", "b"].
split @s @sep :: String, String -> Array =
    parts = []
    current = ""
    loop c in @s:
        at_sep = c == sep
        parts = check at_sep:
            true -> parts ++ [copy current];
            false -> parts
        current = check at_sep:
            true -> "";
            false -> current + c
    parts ++ [current]

# `s` repeated `n` times.
repeat @s n :: String, Int -> String =
    out = ""
    loop i in [0..n]:
        out = out + s
    out

# -- input and output --------------------------------------------------------
#
# `native` functions have only a signature here: the runtime gives them
# (`src/runtime/core.lir`, each through a function of the same name, such as
# `rt.read_line`), since they reach outside the program. Like the rest of
# the library, they borrow what they only read.

# The next line of the input (stdin), without its line ending, or void
# when the input has ended.
native read_line :: String?

# The rest of the input, all at once ("" when it has ended).
native read_all :: String

# Prints `s` as it is, without a newline after it (`echo` adds one).
native print @s :: String -> Void

# The strings of `parts` joined into one, each copied once.
native concat @parts :: [String] -> String

# The arguments the program was started with (not the program's own name).
native args :: [String]

# What the file at `path` holds, or void if it cannot be read.
native read_file @path :: String -> String?

# Makes the file at `path` hold `text`, creating it or replacing what it
# held: whether that worked.
native write_file @path @text :: String, String -> Boolean

# Ends the program right away, with `code` as its exit code (0 means it
# went well).
native exit code :: Int -> Void

# The lines of `s`: the parts between the "\n"s, without a last empty one
# when `s` ends with "\n". A "\r" is left out, so "\r\n" line endings work
# too.
lines @s :: String -> Array =
    parts = []
    current = ""
    loop c in @s:
        ends = c == "\n"
        parts = check ends:
            true -> parts ++ [copy current];
            false -> parts
        current = check ends:
            true -> "";
            false -> check c == "\r":
                true -> current;
                false -> current + c
    check current == "":
        true -> parts;
        false -> parts ++ [current]

# The whole number written in `s`, like "42", "-7" or "+3", or void if `s`
# is not one.
to_int @s :: String -> Int? =
    n = 0
    negative = false
    digits = 0
    loop i, c in @s:
        d = index_of "0123456789" c
        sign = check i:
            0 -> index_of "+-" c;
            else -> void
        check d:
            void -> check sign:
                void -> ret void;
                else -> void
            else -> void
        negative = check sign:
            1 -> true;
            else -> negative
        n = check d:
            void -> n;
            else -> n * 10 + d
        digits = check d:
            void -> digits;
            else -> digits + 1
    check digits:
        0 -> void;
        else -> check negative:
            true -> -n;
            false -> n

# The number written in `s`, like "3.25", "-0.5" or "42", as a float, or
# void if `s` is not one.
to_float @s :: String -> Float? =
    m = 0
    scale = 1.0
    negative = false
    digits = 0
    dot = false
    loop i, c in @s:
        d = index_of "0123456789" c
        sign = check i:
            0 -> index_of "+-" c;
            else -> void
        point = check dot:
            true -> false;
            false -> c == "."
        check d:
            void -> check sign:
                void -> check point:
                    true -> void;
                    else -> ret void
                else -> void
            else -> void
        negative = check sign:
            1 -> true;
            else -> negative
        m = check d:
            void -> m;
            else -> m * 10 + d
        scale = check dot:
            true -> check d:
                void -> scale;
                else -> scale * 10
            false -> scale
        digits = check d:
            void -> digits;
            else -> digits + 1
        dot = check point:
            true -> true;
            false -> dot
    check digits:
        0 -> void;
        else -> check negative:
            true -> -(m / scale);
            false -> m / scale
