; Luna runtime, written in LIR.
;
; It is parsed and compiled together with every program, along with the
; operating system layer for the target (windows.lir, macos.lir), which
; provides:
;
;   @rt.start()                         process entry point; calls @luna.main
;   @rt.sys_write(%stream, %p, %n)      write n bytes; stream 1 = stdout, 2 = stderr
;   @rt.sys_exit(%code)                 terminate the process (does not return)
;   @rt.sys_alloc(%size) -> i64         fresh zeroed read/write memory, 0 on failure
;   @rt.sys_free(%p, %size)             return memory from @rt.sys_alloc to the OS
;
; Object layouts:
;   string: { len: i64, bytes[len] }
;           Storing the length up front (instead of ending with a 0 byte
;           like C) makes length O(1) and lets strings contain any byte.
;   box:    { tag: i64, payload: i64 }   tags: 1 int, 2 float, 3 string, 4 boolean, 5 void, 6 array
;   array:  { len: i64, elements[len] }  8 bytes per element
;
; Objects that may be freed sit right after an allocator header (see
; @rt.alloc); string literals have an immortal header so they can be
; treated like any other string.

data @rt.heap_ptr = { i64 0 }
data @rt.heap_end = { i64 0 }
; free list heads for the 8 small size classes (see @rt.alloc)
data @rt.free_lists = { zero 64 }
; number of objects allocated and not freed yet; tests use it to find leaks
data @rt.live = { i64 0 }
; the one void, for values of maybe types (`int?`): an immortal box
; { header -1, tag 5, payload 0 }
data @rt.void_box = { i64 -1, i64 5, i64 0 }
; output buffer: { len: i64, bytes[4096] }
; Every write to the terminal is a system call, which costs far more than
; copying a few bytes. Output is collected here and written in one go when
; the buffer fills up or the program ends (@rt.flush), the same way C's
; stdio does it. Anything printed to stderr flushes stdout first, so the
; two streams still appear in the right order.
data @rt.outbuf = { i64 0, zero 4096 }

data @rt.s_true = { i64 4, bytes "true" }
data @rt.s_false = { i64 5, bytes "false" }
data @rt.s_void = { i64 4, bytes "void" }
data @rt.s_newline = { i64 1, bytes "\n" }
data @rt.s_nan = { i64 3, bytes "nan" }
data @rt.s_inf = { i64 8, bytes "infinite" }
data @rt.s_zero_float = { i64 3, bytes "0.0" }
data @rt.s_zero_dot = { i64 2, bytes "0." }
data @rt.s_dot_zero = { i64 2, bytes ".0" }
data @rt.s_oom = { i64 26, bytes "MemoryError: out of memory" }
data @rt.s_type_expected = { i64 20, bytes "TypeError: expected " }
data @rt.s_type_found = { i64 8, bytes ", found " }
data @rt.s_op_prefix = { i64 21, bytes "TypeError: operator `" }
data @rt.s_op_middle = { i64 23, bytes "` cannot be applied to " }
data @rt.s_and = { i64 5, bytes " and " }
data @rt.s_int = { i64 3, bytes "int" }
data @rt.s_float = { i64 5, bytes "float" }
data @rt.s_string = { i64 6, bytes "string" }
data @rt.s_boolean = { i64 7, bytes "boolean" }
data @rt.s_unknown = { i64 7, bytes "unknown" }
data @rt.s_array = { i64 5, bytes "array" }
data @rt.s_no_match = { i64 29, bytes "TypeError: no definition of `" }
data @rt.s_no_match_end = { i64 25, bytes "` accepts these arguments" }

; ---------------------------------------------------------------------------
; Process exit
; ---------------------------------------------------------------------------

func @rt.exit(%code: i64) {
entry:
  call void @rt.flush()
  call void @rt.sys_exit(%code)
  unreachable
}

; Print a message (string object) and a newline to stderr, then exit with code 1.
func @rt.fatal(%msg: i64) {
entry:
  call void @rt.flush()
  call void @rt.err_str(%msg)
  %nl = addr @rt.s_newline
  call void @rt.err_str(%nl)
  %one = iconst 1
  call void @rt.sys_exit(%one)
  unreachable
}

; ---------------------------------------------------------------------------
; Memory
; ---------------------------------------------------------------------------

; Allocator: size classes with free lists.
;
; Every block starts with an 8-byte header; the pointer handed out points
; just past it, at the object itself:
;
;   [ header: i64 ][ object ... ]
;                  ^ pointer returned by @rt.alloc, passed to @rt.free
;
; The header says how to free the block:
;   0..7     small block of size class c, whose block size is 16 << c bytes
;            (16, 32, 64, ... 2048), so it holds up to (16 << c) - 8 bytes
;   >= 8     large block: the total number of bytes, header included
;   < 0      immortal: never freed (constant data, such as string literals)
;
; Small blocks: freeing one pushes it onto the free list of its class, and
; allocating pops from that list, so a freed block is reused by the next
; request of a similar size. Both are O(1). A freed block stores the "next"
; link of its free list in its own object area, so the lists cost no extra
; memory. Fresh small blocks are carved from 4 MiB chunks taken from the OS.
;
; Large blocks (more than 2040 bytes) are rare and big, so each gets its own
; memory from the OS and goes straight back to the OS when freed.
;
; Memory from @rt.alloc is not zeroed: a reused block holds old data.

func @rt.alloc(%size: i64) -> i64 {
entry:
  %zero = iconst 0
  %one = iconst 1
  %live_slot = addr @rt.live
  %live = load i64 %live_slot, 0
  %live_more = iadd %live, %one
  store i64 %live_slot, 0, %live_more
  %eight = iconst 8
  %sixteen = iconst 16
  %max_small = iconst 2040
  %small = icmp sle %size, %max_small
  br %small, find_class(%zero, %sixteen), large
; smallest class c whose block (16 << c) holds size + 8 header bytes
find_class(%c: i64, %block: i64):
  %capacity = isub %block, %eight
  %fits = icmp sle %size, %capacity
  br %fits, have_class, next_class
next_class:
  %c_next = iadd %c, %one
  %block_next = shl %block, %one
  jmp find_class(%c_next, %block_next)
have_class:
  %lists = addr @rt.free_lists
  %three = iconst 3
  %list_off = shl %c, %three
  %list = iadd %lists, %list_off
  %head = load i64 %list, 0
  %empty = icmp eq %head, %zero
  br %empty, carve, reuse
reuse:
  ; pop: the list now starts at the block the old head linked to
  %next = load i64 %head, 0
  store i64 %list, 0, %next
  ret %head
carve:
  %fresh = call i64 @rt.carve(%block)
  store i64 %fresh, 0, %c
  %object = iadd %fresh, %eight
  ret %object
large:
  %total = iadd %size, %eight
  %mem = call i64 @rt.sys_alloc(%total)
  %failed = icmp eq %mem, %zero
  br %failed, oom, mapped
oom:
  %msg = addr @rt.s_oom
  call void @rt.fatal(%msg)
  unreachable
mapped:
  store i64 %mem, 0, %total
  %large_object = iadd %mem, %eight
  ret %large_object
}

; Return a block allocated by @rt.alloc. Immortal objects are left alone.
func @rt.free(%p: i64) {
entry:
  %header = load i64 %p, -8
  %zero = iconst 0
  %immortal = icmp slt %header, %zero
  br %immortal, done, mortal
mortal:
  %live_slot = addr @rt.live
  %live = load i64 %live_slot, 0
  %one = iconst 1
  %live_less = isub %live, %one
  store i64 %live_slot, 0, %live_less
  %eight = iconst 8
  %small = icmp slt %header, %eight
  br %small, push, large
push:
  ; push: the block links to the old head and becomes the new head
  %lists = addr @rt.free_lists
  %three = iconst 3
  %list_off = shl %header, %three
  %list = iadd %lists, %list_off
  %head = load i64 %list, 0
  store i64 %p, 0, %head
  store i64 %list, 0, %p
  ret
large:
  %block = isub %p, %eight
  call void @rt.sys_free(%block, %header)
  ret
done:
  ret
}

; Bump allocation of fresh small blocks: keep a pointer into a 4 MiB chunk
; and move it forward by each block's size; take a new chunk from the OS
; when the current one runs out (the unused tail of the old one is lost).
func @rt.carve(%n: i64) -> i64 {
entry:
  %ptr_slot = addr @rt.heap_ptr
  %ptr = load i64 %ptr_slot, 0
  %end_slot = addr @rt.heap_end
  %end = load i64 %end_slot, 0
  %new_ptr = iadd %ptr, %n
  ; heap_end starts at 0, so the very first call always takes a chunk
  %fits = icmp ule %new_ptr, %end
  br %fits, bump, grow
bump:
  store i64 %ptr_slot, 0, %new_ptr
  ret %ptr
grow:
  %chunk = iconst 4194304
  %null = iconst 0
  %mem = call i64 @rt.sys_alloc(%chunk)
  %failed = icmp eq %mem, %null
  br %failed, oom, mapped
oom:
  %msg = addr @rt.s_oom
  call void @rt.fatal(%msg)
  unreachable
mapped:
  %chunk_end = iadd %mem, %chunk
  store i64 %end_slot, 0, %chunk_end
  %after = iadd %mem, %n
  store i64 %ptr_slot, 0, %after
  ret %mem
}

func @rt.memcpy(%dst: i64, %src: i64, %n: i64) {
entry:
  %zero = iconst 0
  %one = iconst 1
  jmp loop(%zero)
loop(%i: i64):
  %more = icmp slt %i, %n
  br %more, body, done
body:
  %s = iadd %src, %i
  %byte = load u8 %s, 0
  %d = iadd %dst, %i
  store u8 %d, 0, %byte
  %next = iadd %i, %one
  jmp loop(%next)
done:
  ret
}

; Free a box. A box owns its payload, so a string inside is freed too
; (the other kinds are plain numbers stored in the box itself).
func @rt.drop_box(%b: i64) {
entry:
  %tag = load i64 %b, 0
  %string_tag = iconst 3
  %holds_string = icmp eq %tag, %string_tag
  br %holds_string, payload, shell
payload:
  %s = load i64 %b, 8
  call void @rt.free(%s)
  jmp shell
shell:
  call void @rt.free(%b)
  ret
}

func @rt.box(%tag: i64, %payload: i64) -> i64 {
entry:
  %size = iconst 16
  %p = call i64 @rt.alloc(%size)
  store i64 %p, 0, %tag
  store i64 %p, 8, %payload
  ret %p
}

; ---------------------------------------------------------------------------
; Output
; ---------------------------------------------------------------------------

; Write n bytes at p to a stream (1 = stdout, 2 = stderr).
func @rt.write(%stream: i64, %p: i64, %n: i64) {
entry:
  %zero = iconst 0
  %empty = icmp sle %n, %zero
  br %empty, done, write
write:
  call void @rt.sys_write(%stream, %p, %n)
  ret
done:
  ret
}

func @rt.flush() {
entry:
  %buf = addr @rt.outbuf
  %len = load i64 %buf, 0
  %stdout = iconst 1
  %eight = iconst 8
  %bytes = iadd %buf, %eight
  call void @rt.write(%stdout, %bytes, %len)
  %zero = iconst 0
  store i64 %buf, 0, %zero
  ret
}

; Append n bytes at p to the stdout buffer.
func @rt.out(%p: i64, %n: i64) {
entry:
  %cap = iconst 4096
  %buf = addr @rt.outbuf
  %eight = iconst 8
  %too_big = icmp sgt %n, %cap
  br %too_big, direct, buffered
direct:
  call void @rt.flush()
  %stdout = iconst 1
  call void @rt.write(%stdout, %p, %n)
  ret
buffered:
  %len = load i64 %buf, 0
  %end = iadd %len, %n
  %overflow = icmp sgt %end, %cap
  br %overflow, flush_first, copy
flush_first:
  call void @rt.flush()
  jmp copy
copy:
  %cur = load i64 %buf, 0
  %base = iadd %buf, %eight
  %dst = iadd %base, %cur
  call void @rt.memcpy(%dst, %p, %n)
  %new_len = iadd %cur, %n
  store i64 %buf, 0, %new_len
  ret
}

func @rt.out_byte(%c: i64) {
entry:
  %cell = alloca 8
  store u8 %cell, 0, %c
  %one = iconst 1
  call void @rt.out(%cell, %one)
  ret
}

func @rt.out_zeros(%n: i64) {
entry:
  %zero = iconst 0
  %one = iconst 1
  %ch = iconst 48
  jmp loop(%n)
loop(%left: i64):
  %more = icmp sgt %left, %zero
  br %more, body, done
body:
  call void @rt.out_byte(%ch)
  %next = isub %left, %one
  jmp loop(%next)
done:
  ret
}

func @rt.err_str(%s: i64) {
entry:
  %len = load i64 %s, 0
  %eight = iconst 8
  %bytes = iadd %s, %eight
  %stderr = iconst 2
  call void @rt.write(%stderr, %bytes, %len)
  ret
}

; Write the decimal digits of unsigned x into buf[start..32]; returns start.
; Dividing by 10 produces digits from the last to the first, so they are
; written backwards from the end of the buffer, and no reversal is needed.
func @rt.utoa(%buf: i64, %x: i64) -> i64 {
entry:
  %ten = iconst 10
  %zero = iconst 0
  %one = iconst 1
  %ascii0 = iconst 48
  %end = iconst 32
  jmp loop(%x, %end)
loop(%v: i64, %pos: i64):
  %q = udiv %v, %ten
  %r = urem %v, %ten
  %ch = iadd %r, %ascii0
  %p = isub %pos, %one
  %at = iadd %buf, %p
  store u8 %at, 0, %ch
  %done = icmp eq %q, %zero
  br %done, finish, loop(%q, %p)
finish:
  ret %p
}

func @rt.print_str(%s: i64) {
entry:
  %len = load i64 %s, 0
  %eight = iconst 8
  %bytes = iadd %s, %eight
  call void @rt.out(%bytes, %len)
  ret
}

func @rt.print_newline() {
entry:
  %nl = iconst 10
  call void @rt.out_byte(%nl)
  ret
}

func @rt.print_bool(%b: i64) {
entry:
  br %b, yes, no
yes:
  %t = addr @rt.s_true
  call void @rt.print_str(%t)
  ret
no:
  %f = addr @rt.s_false
  call void @rt.print_str(%f)
  ret
}

func @rt.print_void() {
entry:
  %v = addr @rt.s_void
  call void @rt.print_str(%v)
  ret
}

func @rt.print_int(%v: i64) {
entry:
  %buf = alloca 40
  %zero = iconst 0
  %one = iconst 1
  %end = iconst 32
  %neg = icmp slt %v, %zero
  ; Block parameters in action: `digits` receives the magnitude from either
  ; edge, %v itself or its negation, as its parameter %mag.
  br %neg, negate, digits(%v)
negate:
  ; wrapping negation; i64::MIN stays correct as an unsigned magnitude
  %m = isub %zero, %v
  jmp digits(%m)
digits(%mag: i64):
  %start = call i64 @rt.utoa(%buf, %mag)
  br %neg, minus, emit(%start)
minus:
  %s1 = isub %start, %one
  %at = iadd %buf, %s1
  %dash = iconst 45
  store u8 %at, 0, %dash
  jmp emit(%s1)
emit(%from: i64):
  %p = iadd %buf, %from
  %n = isub %end, %from
  call void @rt.out(%p, %n)
  ret
}

; 10^|e| as a float (exact for |e| <= 22).
func @rt.pow10(%e: i64) -> f64 {
entry:
  %zero = iconst 0
  %one = iconst 1
  %ten = fconst 10.0
  %unit = fconst 1.0
  %neg = icmp slt %e, %zero
  br %neg, flip, loop(%e, %unit)
flip:
  %abs = isub %zero, %e
  jmp loop(%abs, %unit)
loop(%n: i64, %acc: f64):
  %more = icmp sgt %n, %zero
  br %more, body, done
body:
  %acc2 = fmul %acc, %ten
  %n2 = isub %n, %one
  jmp loop(%n2, %acc2)
done:
  ret %acc
}

; Prints a float with up to 15 significant digits, Python style:
; 3.0, 0.1, 1234.5, 1e-05, 1.5e+20, inf, nan.
;
; Printing floats exactly is famously hard (see the Ryu and Grisu
; algorithms). This simpler method is good enough for 15 significant
; digits: any 15-digit decimal survives the trip through a double unchanged,
; so all 15 printed digits are meaningful:
;   1. handle nan, the sign, inf and 0;
;   2. find the decimal exponent e with 1 <= a / 10^e < 10;
;   3. scale the mantissa to a 15-digit integer and round it;
;   4. drop trailing zeros and print either positionally (123.45) or in
;      scientific notation (1.2345e+20), choosing like Python's repr.
func @rt.print_float(%f: f64) {
entry:
  %zero = iconst 0
  %one = iconst 1
  %fifteen = iconst 15
  %ten_f = fconst 10.0
  %one_f = fconst 1.0
  %is_nan = fcmp ne %f, %f
  br %is_nan, nan, number
nan:
  %s_nan = addr @rt.s_nan
  call void @rt.print_str(%s_nan)
  ret
number:
  %bits = bitcast %f to i64
  %negative = icmp slt %bits, %zero
  br %negative, minus, magnitude
minus:
  %dash = iconst 45
  call void @rt.out_byte(%dash)
  jmp magnitude
magnitude:
  %abs_mask = iconst 0x7fffffffffffffff
  %abs_bits = and %bits, %abs_mask
  %a = bitcast %abs_bits to f64
  %inf = fconst inf
  %is_inf = fcmp eq %a, %inf
  br %is_inf, infinite, finite
infinite:
  %s_inf = addr @rt.s_inf
  call void @rt.print_str(%s_inf)
  ret
finite:
  %zero_f = fconst 0.0
  %is_zero = fcmp eq %a, %zero_f
  br %is_zero, print_zero, scale_down(%a, %zero)
print_zero:
  %s_zero = addr @rt.s_zero_float
  call void @rt.print_str(%s_zero)
  ret

; normalize: find e with 10^e <= a < 10^(e+1)
scale_down(%m: f64, %e: i64):
  %big = fcmp ge %m, %ten_f
  br %big, divide, scale_up(%m, %e)
divide:
  %m_div = fdiv %m, %ten_f
  %e_inc = iadd %e, %one
  jmp scale_down(%m_div, %e_inc)
scale_up(%m2: f64, %e2: i64):
  %small = fcmp lt %m2, %one_f
  br %small, multiply, normalized
multiply:
  %m_mul = fmul %m2, %ten_f
  %e_dec = isub %e2, %one
  jmp scale_up(%m_mul, %e_dec)
normalized:
  ; recompute the mantissa with a single rounding when 10^|e| is exact
  %lim_hi = iconst 22
  %lim_lo = iconst -22
  %in_hi = icmp sle %e2, %lim_hi
  %in_lo = icmp sge %e2, %lim_lo
  %exact = and %in_hi, %in_lo
  br %exact, refine, round(%m2, %e2)
refine:
  %p10 = call f64 @rt.pow10(%e2)
  %e_pos = icmp sge %e2, %zero
  br %e_pos, refine_div, refine_mul
refine_div:
  %m_exact_div = fdiv %a, %p10
  jmp round(%m_exact_div, %e2)
refine_mul:
  %m_exact_mul = fmul %a, %p10
  jmp round(%m_exact_mul, %e2)

; 15 significant digits as an integer
round(%mr: f64, %er: i64):
  %scale = fconst 1e14
  %scaled = fmul %mr, %scale
  %half = fconst 0.5
  %biased = fadd %scaled, %half
  %digits = fptosi %biased
  %limit = iconst 1000000000000000
  %carry = icmp sge %digits, %limit
  br %carry, carried, trim(%digits, %er, %fifteen)
carried:
  %ten_i = iconst 10
  %digits_c = sdiv %digits, %ten_i
  %er_c = iadd %er, %one
  jmp trim(%digits_c, %er_c, %fifteen)

; strip trailing zero digits
trim(%d: i64, %ex: i64, %nd: i64):
  %ten_t = iconst 10
  %rem = srem %d, %ten_t
  %rem_zero = icmp eq %rem, %zero
  %several = icmp sgt %nd, %one
  %strip = and %rem_zero, %several
  br %strip, strip_one, format
strip_one:
  %d_next = sdiv %d, %ten_t
  %nd_next = isub %nd, %one
  jmp trim(%d_next, %ex, %nd_next)

format:
  %buf = alloca 40
  %start = call i64 @rt.utoa(%buf, %d)
  %dp = iadd %buf, %start
  %minus4 = iconst -4
  %sixteen = iconst 16
  %ge_lo = icmp sge %ex, %minus4
  %lt_hi = icmp slt %ex, %sixteen
  %positional = and %ge_lo, %lt_hi
  br %positional, fixed, scientific
fixed:
  %ex_neg = icmp slt %ex, %zero
  br %ex_neg, fraction_only, has_int_part
fraction_only:
  ; 0.000ddd
  %s_zd = addr @rt.s_zero_dot
  call void @rt.print_str(%s_zd)
  %neg_ex = isub %zero, %ex
  %zeros = isub %neg_ex, %one
  call void @rt.out_zeros(%zeros)
  call void @rt.out(%dp, %nd)
  ret
has_int_part:
  %int_len = iadd %ex, %one
  %all_int = icmp sle %nd, %int_len
  br %all_int, int_only, split
int_only:
  ; ddd000.0
  call void @rt.out(%dp, %nd)
  %pad = isub %int_len, %nd
  call void @rt.out_zeros(%pad)
  %s_dz = addr @rt.s_dot_zero
  call void @rt.print_str(%s_dz)
  ret
split:
  ; ddd.ddd
  call void @rt.out(%dp, %int_len)
  %dot = iconst 46
  call void @rt.out_byte(%dot)
  %frac = iadd %dp, %int_len
  %frac_len = isub %nd, %int_len
  call void @rt.out(%frac, %frac_len)
  ret
scientific:
  ; d[.ddd]e(+|-)XX
  call void @rt.out(%dp, %one)
  %has_frac = icmp sgt %nd, %one
  br %has_frac, sci_frac, sci_exp
sci_frac:
  %dot2 = iconst 46
  call void @rt.out_byte(%dot2)
  %rest = iadd %dp, %one
  %rest_len = isub %nd, %one
  call void @rt.out(%rest, %rest_len)
  jmp sci_exp
sci_exp:
  %e_char = iconst 101
  call void @rt.out_byte(%e_char)
  %exp_neg = icmp slt %ex, %zero
  br %exp_neg, exp_minus, exp_plus
exp_minus:
  %minus_char = iconst 45
  call void @rt.out_byte(%minus_char)
  %abs_ex = isub %zero, %ex
  jmp exp_digits(%abs_ex)
exp_plus:
  %plus_char = iconst 43
  call void @rt.out_byte(%plus_char)
  jmp exp_digits(%ex)
exp_digits(%ev: i64):
  %ten_e = iconst 10
  %one_digit = icmp slt %ev, %ten_e
  br %one_digit, exp_pad, exp_num
exp_pad:
  %zero_char = iconst 48
  call void @rt.out_byte(%zero_char)
  jmp exp_num
exp_num:
  call void @rt.print_int(%ev)
  ret
}

; ---------------------------------------------------------------------------
; Strings
; ---------------------------------------------------------------------------

func @rt.str_concat(%a: i64, %b: i64) -> i64 {
entry:
  %la = load i64 %a, 0
  %lb = load i64 %b, 0
  %n = iadd %la, %lb
  %eight = iconst 8
  %size = iadd %n, %eight
  %p = call i64 @rt.alloc(%size)
  store i64 %p, 0, %n
  %dst = iadd %p, %eight
  %src_a = iadd %a, %eight
  call void @rt.memcpy(%dst, %src_a, %la)
  %dst_b = iadd %dst, %la
  %src_b = iadd %b, %eight
  call void @rt.memcpy(%dst_b, %src_b, %lb)
  ret %p
}

; Strings with different lengths are never equal, so lengths are compared
; first; only equal-length strings are compared byte by byte.
func @rt.str_eq(%a: i64, %b: i64) -> i64 {
entry:
  %zero = iconst 0
  %one = iconst 1
  %la = load i64 %a, 0
  %lb = load i64 %b, 0
  %same_len = icmp eq %la, %lb
  br %same_len, loop(%zero), differ
loop(%i: i64):
  %more = icmp slt %i, %la
  br %more, body, equal
body:
  %pa = iadd %a, %i
  %ca = load u8 %pa, 8
  %pb = iadd %b, %i
  %cb = load u8 %pb, 8
  %same = icmp eq %ca, %cb
  %next = iadd %i, %one
  br %same, loop(%next), differ
equal:
  ret %one
differ:
  ret %zero
}

; Lexicographic byte comparison: -1, 0 or 1.
func @rt.str_cmp(%a: i64, %b: i64) -> i64 {
entry:
  %zero = iconst 0
  %one = iconst 1
  %minus_one = iconst -1
  %la = load i64 %a, 0
  %lb = load i64 %b, 0
  %a_shorter = icmp slt %la, %lb
  br %a_shorter, scan(%la), scan(%lb)
scan(%min: i64):
  jmp loop(%zero)
loop(%i: i64):
  %more = icmp slt %i, %min
  br %more, body, by_length
body:
  %pa = iadd %a, %i
  %ca = load u8 %pa, 8
  %pb = iadd %b, %i
  %cb = load u8 %pb, 8
  %lt = icmp ult %ca, %cb
  br %lt, less, check_gt
check_gt:
  %gt = icmp ugt %ca, %cb
  %next = iadd %i, %one
  br %gt, greater, loop(%next)
by_length:
  %shorter = icmp slt %la, %lb
  br %shorter, less, check_longer
check_longer:
  %longer = icmp sgt %la, %lb
  br %longer, greater, equal
less:
  ret %minus_one
greater:
  ret %one
equal:
  ret %zero
}

; A copy of a string. Immortal strings (literals) are shared instead.
func @rt.str_copy(%s: i64) -> i64 {
entry:
  %header = load i64 %s, -8
  %zero = iconst 0
  %immortal = icmp slt %header, %zero
  br %immortal, shared, copy
shared:
  ret %s
copy:
  %len = load i64 %s, 0
  %eight = iconst 8
  %size = iadd %len, %eight
  %p = call i64 @rt.alloc(%size)
  store i64 %p, 0, %len
  %dst = iadd %p, %eight
  %src = iadd %s, %eight
  call void @rt.memcpy(%dst, %src, %len)
  ret %p
}

; The bytes [from, to) of a string, as a new string.
func @rt.str_sub(%s: i64, %from: i64, %to: i64) -> i64 {
entry:
  %len = isub %to, %from
  %eight = iconst 8
  %size = iadd %len, %eight
  %p = call i64 @rt.alloc(%size)
  store i64 %p, 0, %len
  %dst = iadd %p, %eight
  %base = iadd %s, %eight
  %src = iadd %base, %from
  call void @rt.memcpy(%dst, %src, %len)
  ret %p
}

; Strings are UTF-8: a character takes 1 to 4 bytes, and its first byte
; says how many. The bytes after the first all look like 10xxxxxx.

; How many bytes the character starting at byte `pos` takes.
func @rt.utf8_width(%s: i64, %pos: i64) -> i64 {
entry:
  %at = iadd %s, %pos
  %b = load u8 %at, 8
  %x80 = iconst 128
  %one_byte = icmp ult %b, %x80
  br %one_byte, w1, not1
w1:
  %one = iconst 1
  ret %one
not1:
  %xe0 = iconst 224
  %two_bytes = icmp ult %b, %xe0
  br %two_bytes, w2, not2
w2:
  %two = iconst 2
  ret %two
not2:
  %xf0 = iconst 240
  %three_bytes = icmp ult %b, %xf0
  br %three_bytes, w3, w4
w3:
  %three = iconst 3
  ret %three
w4:
  %four = iconst 4
  ret %four
}

; The number of characters in a string (not bytes).
func @rt.str_chars(%s: i64) -> i64 {
entry:
  %len = load i64 %s, 0
  %zero = iconst 0
  %one = iconst 1
  %mask = iconst 192
  %continuation = iconst 128
  jmp loop(%zero, %zero)
loop(%i: i64, %count: i64):
  %more = icmp slt %i, %len
  br %more, body, done
body:
  %at = iadd %s, %i
  %b = load u8 %at, 8
  %top = and %b, %mask
  %is_cont = icmp eq %top, %continuation
  %starts = xor %is_cont, %one
  %count_next = iadd %count, %starts
  %i_next = iadd %i, %one
  jmp loop(%i_next, %count_next)
done:
  ret %count
}

; The byte position where character `n` starts; the string's length in
; bytes for n = the number of characters; -1 if n is out of range.
func @rt.str_char_offset(%s: i64, %n: i64) -> i64 {
entry:
  %zero = iconst 0
  %minus_one = iconst -1
  %len = load i64 %s, 0
  %negative = icmp slt %n, %zero
  br %negative, out, walk(%zero, %zero)
walk(%pos: i64, %k: i64):
  %found = icmp eq %k, %n
  br %found, at, step
at:
  ret %pos
step:
  %more = icmp slt %pos, %len
  br %more, advance, out
advance:
  %w = call i64 @rt.utf8_width(%s, %pos)
  %pos_next = iadd %pos, %w
  %one = iconst 1
  %k_next = iadd %k, %one
  jmp walk(%pos_next, %k_next)
out:
  ret %minus_one
}

; The characters of a string in the opposite order (each character's bytes
; stay in their order, so multi-byte characters survive).
func @rt.str_reverse(%s: i64) -> i64 {
entry:
  %len = load i64 %s, 0
  %eight = iconst 8
  %size = iadd %len, %eight
  %r = call i64 @rt.alloc(%size)
  store i64 %r, 0, %len
  %zero = iconst 0
  %from = iadd %s, %eight
  %into = iadd %r, %eight
  jmp loop(%zero)
loop(%pos: i64):
  %more = icmp slt %pos, %len
  br %more, body, done
body:
  ; the character at %pos goes to len - pos - width
  %w = call i64 @rt.utf8_width(%s, %pos)
  %rest = isub %len, %pos
  %to = isub %rest, %w
  %src = iadd %from, %pos
  %dst = iadd %into, %to
  call void @rt.memcpy(%dst, %src, %w)
  %next = iadd %pos, %w
  jmp loop(%next)
done:
  ret %r
}

; Character `n` of a string as a new one-character string, or 0 (void) if
; there is no such character.
func @rt.str_char_at(%s: i64, %n: i64) -> i64 {
entry:
  %from = call i64 @rt.str_char_offset(%s, %n)
  %len = load i64 %s, 0
  %zero = iconst 0
  %negative = icmp slt %from, %zero
  %at_end = icmp eq %from, %len
  %missing = or %negative, %at_end
  br %missing, none, some
none:
  ret %zero
some:
  %w = call i64 @rt.utf8_width(%s, %from)
  %to = iadd %from, %w
  %c = call i64 @rt.str_sub(%s, %from, %to)
  ret %c
}

; ---------------------------------------------------------------------------
; Arrays
; ---------------------------------------------------------------------------
;
; array: { len: i64, elements[len] }, 8 bytes per element: an int, a float's
; bits, or a pointer (string, array, box), depending on the element type.
; Freeing, copying and printing arrays depend on the element type, so the
; compiler generates those functions per type (see typefns.rs).

func @rt.array_new(%n: i64) -> i64 {
entry:
  %three = iconst 3
  %bytes = shl %n, %three
  %eight = iconst 8
  %size = iadd %bytes, %eight
  %p = call i64 @rt.alloc(%size)
  store i64 %p, 0, %n
  ret %p
}

; Append the 8-byte value %v to the array being built in %cell, a cell
; { array, len, capacity } (list comprehensions whose size is not known in
; advance). When the array is full, it is replaced by one twice as large.
func @rt.vec_push(%cell: i64, %v: i64) {
entry:
  %zero = iconst 0
  %one = iconst 1
  %three = iconst 3
  %eight = iconst 8
  %four = iconst 4
  %array = load i64 %cell, 0
  %len = load i64 %cell, 8
  %cap = load i64 %cell, 16
  %full = icmp eq %len, %cap
  br %full, grow, put(%array)
grow:
  %empty = icmp eq %cap, %zero
  br %empty, resize(%four), double
double:
  %twice = iadd %cap, %cap
  jmp resize(%twice)
resize(%new_cap: i64):
  %bigger = call i64 @rt.array_new(%new_cap)
  %bytes = shl %len, %three
  %dst = iadd %bigger, %eight
  %src = iadd %array, %eight
  call void @rt.memcpy(%dst, %src, %bytes)
  call void @rt.free(%array)
  store i64 %cell, 0, %bigger
  store i64 %cell, 16, %new_cap
  jmp put(%bigger)
put(%a: i64):
  %offset = shl %len, %three
  %at = iadd %a, %offset
  store i64 %at, 8, %v
  %len_next = iadd %len, %one
  store i64 %cell, 8, %len_next
  ret
}

; '"' string '"', for strings inside printed arrays.
func @rt.print_quoted(%s: i64) {
entry:
  %quote = iconst 34
  call void @rt.out_byte(%quote)
  call void @rt.print_str(%s)
  call void @rt.out_byte(%quote)
  ret
}

; ---------------------------------------------------------------------------
; Runtime type errors
; ---------------------------------------------------------------------------

func @rt.err_tag(%tag: i64) {
entry:
  %t1 = iconst 1
  %is_int = icmp eq %tag, %t1
  br %is_int, int, not_int
int:
  %s_int = addr @rt.s_int
  call void @rt.err_str(%s_int)
  ret
not_int:
  %t2 = iconst 2
  %is_float = icmp eq %tag, %t2
  br %is_float, float, not_float
float:
  %s_float = addr @rt.s_float
  call void @rt.err_str(%s_float)
  ret
not_float:
  %t3 = iconst 3
  %is_string = icmp eq %tag, %t3
  br %is_string, string, not_string
string:
  %s_string = addr @rt.s_string
  call void @rt.err_str(%s_string)
  ret
not_string:
  %t4 = iconst 4
  %is_bool = icmp eq %tag, %t4
  br %is_bool, boolean, not_bool
boolean:
  %s_boolean = addr @rt.s_boolean
  call void @rt.err_str(%s_boolean)
  ret
not_bool:
  %t5 = iconst 5
  %is_void = icmp eq %tag, %t5
  br %is_void, void, not_void
not_void:
  %t6 = iconst 6
  %is_array = icmp eq %tag, %t6
  br %is_array, array, unknown
array:
  %s_array = addr @rt.s_array
  call void @rt.err_str(%s_array)
  ret
void:
  %s_void = addr @rt.s_void
  call void @rt.err_str(%s_void)
  ret
unknown:
  %s_unknown = addr @rt.s_unknown
  call void @rt.err_str(%s_unknown)
  ret
}

; "TypeError: expected <expected>, found <tag>"
func @rt.type_error(%expected: i64, %tag: i64) {
entry:
  call void @rt.flush()
  %s1 = addr @rt.s_type_expected
  call void @rt.err_str(%s1)
  call void @rt.err_str(%expected)
  %s2 = addr @rt.s_type_found
  call void @rt.err_str(%s2)
  call void @rt.err_tag(%tag)
  %nl = addr @rt.s_newline
  call void @rt.err_str(%nl)
  %one = iconst 1
  call void @rt.sys_exit(%one)
  unreachable
}

; "TypeError: no definition of `<name>` accepts these arguments": a call
; decided at run time found no definition for the values it was given.
func @rt.no_match(%name: i64) {
entry:
  call void @rt.flush()
  %s1 = addr @rt.s_no_match
  call void @rt.err_str(%s1)
  call void @rt.err_str(%name)
  %s2 = addr @rt.s_no_match_end
  call void @rt.err_str(%s2)
  %nl = addr @rt.s_newline
  call void @rt.err_str(%nl)
  %one = iconst 1
  call void @rt.sys_exit(%one)
  unreachable
}

; "TypeError: operator `<op>` cannot be applied to <a>[ and <b>]"; b = 0 for unary operators.
func @rt.op_error(%op: i64, %a: i64, %b: i64) {
entry:
  call void @rt.flush()
  %s1 = addr @rt.s_op_prefix
  call void @rt.err_str(%s1)
  call void @rt.err_str(%op)
  %s2 = addr @rt.s_op_middle
  call void @rt.err_str(%s2)
  call void @rt.err_tag(%a)
  %zero = iconst 0
  %binary = icmp ne %b, %zero
  br %binary, second, finish
second:
  %s3 = addr @rt.s_and
  call void @rt.err_str(%s3)
  call void @rt.err_tag(%b)
  jmp finish
finish:
  %nl = addr @rt.s_newline
  call void @rt.err_str(%nl)
  %one = iconst 1
  call void @rt.sys_exit(%one)
  unreachable
}
